{
  "name": "e-track-api",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno run --watch -A --env-file main.ts",
    "start": "deno run --allow-net --allow-env --allow-read main.ts",
    "check": "deno check main.ts main_test.ts",
    "test": "deno test --allow-env --allow-read",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/dotenv/load": "jsr:@std/dotenv@^0.225.8/load",
    "hono": "npm:hono@^4.13.18",
    "hono/cors": "npm:hono@^4.13.18/cors",
    "hono/logger": "npm:hono@^4.13.18/logger",
    "hono/utils/http-status": "npm:hono@^4.13.18/utils/http-status",
    "jose": "npm:jose@^6.2.17",
    "mongoose": "npm:mongoose@^9.12.1"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"]
  }
}
