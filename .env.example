# Copy to .env and adjust for your machine. Never commit .env.
APP_NAME="E Track API"
PORT=8000

# Local MongoDB example. Use Atlas SRV URI in production.
MONGODB_URI="mongodb://127.0.0.1:27017/e_track"

# Use a long random value (at least 32 characters), e.g. openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="24h"

# Comma-separated origins are supported by Hono; "*" is fine for local dev.
CORS_ORIGIN="*"
